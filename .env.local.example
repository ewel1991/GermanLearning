ANTHROPIC_API_KEY=sk-ant-...   # Your Anthropic API key
TAVILY_API_KEY=tvly-...        # Tavily search — https://tavily.com (free tier: 1000 searches/month)
YOUTUBE_API_KEY=...            # YouTube Data API v3 — https://console.cloud.google.com (free quota)
SPOTIFY_CLIENT_ID=...          # Spotify Web API — https://developer.spotify.com/dashboard (free, Client Credentials flow)
SPOTIFY_CLIENT_SECRET=...      # same Spotify app, "Client secret" value
UPSTASH_REDIS_REST_URL=...     # Upstash Redis — add via Vercel Marketplace, stores saved vocabulary (works on Vercel's read-only filesystem)
UPSTASH_REDIS_REST_TOKEN=...   # same Upstash database, "REST Token" value
